# Claude API key (used for summarization, impact analysis, daily digest)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override default models
INTEL_MODEL_FAST=claude-haiku-4-5
INTEL_MODEL_DEEP=claude-sonnet-4-6

# SQLite database path (default: data/intel.db)
INTEL_DB_PATH=data/intel.db

# HTTP request settings
INTEL_HTTP_TIMEOUT=20
INTEL_HTTP_UA=ai-intel/0.1 (+research)
